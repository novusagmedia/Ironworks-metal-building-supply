{
  "outputDirectory": ".",
  "buildCommand": "",
  "installCommand": "",
  "redirects": [
    {
      "source": "/hail-damage.html",
      "destination": "/hail-damage-inspection",
      "permanent": true
    },
    {
      "source": "/Previous_sites_inspo/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ironworks.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ironworks",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/Real_pictures/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/Brand_assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/hail-damage",
      "destination": "https://ironworks-landing-windows-doors.vercel.app"
    },
    {
      "source": "/hail-damage/:path*",
      "destination": "https://ironworks-landing-windows-doors.vercel.app/:path*"
    }
  ],
  "cleanUrls": true
}
